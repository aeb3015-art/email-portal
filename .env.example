# ---------- API + worker (apps/api, Railway) ----------
DATABASE_URL=postgres://inbox:inbox@localhost:5432/inbox
REDIS_URL=redis://localhost:6379
# Comma-separated "keyId:base64(32 bytes)". First key encrypts; all keys decrypt (rotation).
# Generate: echo "k1:$(openssl rand -base64 32)"
# Protects ONLY mailbox credentials/OAuth tokens. Mail content is end-to-end sealed with org keys.
ENCRYPTION_KEYS=k1:REPLACE_WITH_openssl_rand_base64_32
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
PORT=4000
# Only for running API and worker on one machine:
WORKER_HEALTH_PORT=4001
SESSION_TTL_HOURS=336
SYNC_BACKFILL_DAYS=30
SYNC_BACKFILL_MAX=2000
LOG_LEVEL=info
TRUST_PROXY=1

# Outlook / Microsoft 365 OAuth (Azure app registration). Redirect: ${PUBLIC_API_URL}/oauth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Gmail OAuth (Google Cloud). Redirect: ${PUBLIC_API_URL}/oauth/gmail/callback
# The https://mail.google.com/ scope is restricted: public launch requires Google's CASA assessment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional server transcription fallback (OpenAI-compatible /audio/transcriptions)
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=

# ---------- Web (apps/web, Vercel) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
